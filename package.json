{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "prod:start": "node dist/main",
        "migrate:prod": "sequelize-cli db:migrate --env production",
        "build": "nest build",
        "migrate:dev": "npx sequelize-cli db:migrate --env development",
        "migrate:dev:undo": "npx sequelize-cli db:migrate:undo --env development",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
    },
    "dependencies": {
        "@nestjs/common": "11.2.6",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.6",
        "@nestjs/mapped-types": "12.0.0",
        "@nestjs/platform-express": "11.2.6",
        "@nestjs/sequelize": "11.0.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.4",
        "connect-pg-simple": "10.0.0",
        "dotenv": "16.6.1",
        "express-session": "1.19.0",
        "pg": "8.23.0",
        "pg-hstore": "2.3.4",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "sequelize": "6.37.8",
        "sequelize-typescript": "2.1.6"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.2.6",
        "@types/connect-pg-simple": "7.0.3",
        "@types/express": "5.0.6",
        "@types/express-session": "1.19.0",
        "@types/jest": "29.5.14",
        "@types/node": "20.19.43",
        "@types/pg": "8.23.1",
        "@types/sequelize": "4.28.20",
        "@types/supertest": "6.0.3",
        "@typescript-eslint/eslint-plugin": "8.70.1",
        "@typescript-eslint/parser": "8.70.1",
        "eslint": "8.57.1",
        "eslint-config-prettier": "9.1.2",
        "eslint-plugin-prettier": "5.5.6",
        "jest": "29.7.0",
        "prettier": "3.9.9",
        "sequelize-cli": "6.6.5",
        "source-map-support": "0.5.21",
        "supertest": "7.3.0",
        "ts-jest": "29.4.13",
        "ts-loader": "9.6.2",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
